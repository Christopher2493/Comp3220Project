<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted (Claude): temporary main menu for testing the data wiring; Ayushmaan's GUI will replace it. Reviewed by Vince. -->
<!--
  Main menu (first screen). Controller: PrimaryController.
  onAction="#name" calls the @FXML method with that name in the controller.
-->

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="group2.PrimaryController">
   <children>
      <Label text="Clinic Appointment Booking System" />
      <!-- Navigation buttons: each one opens a screen via App.setRoot(...) -->
      <Button fx:id="doctorsButton" text="Doctors" onAction="#openDoctors"/>
      <Button fx:id="patientsButton" text="Patients" onAction="#openPatients"/>
      <Button fx:id="appointmentsButton" text="Appointments" onAction="#openAppointments"/>
      <!-- Closes the app -->
      <Button fx:id="ExitButton" text="Exit" onAction="#exit"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
