<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted (Claude): temporary appointments test screen (book, list, cancel); Ayushmaan's GUI will replace it. Reviewed by Vince. -->
<!--
  Appointments screen. Controller: AppointmentsController.
  fx:id="x" links an element to the @FXML field named x in the controller;
  onAction="#name" calls the @FXML method with that name.
-->

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="group2.AppointmentsController">
   <children>
      <Label text="Appointments" />
      <!-- Booking form: pick patient + doctor, type date + time, then AppointmentsController.book() -->
      <HBox spacing="10.0">
         <children>
            <ComboBox fx:id="patientBox" promptText="Patient" prefWidth="170.0" />
            <ComboBox fx:id="doctorBox" promptText="Doctor" prefWidth="170.0" />
            <TextField fx:id="dateField" promptText="Date" prefWidth="100.0" />
            <TextField fx:id="timeField" promptText="Time" prefWidth="70.0" />
            <Button text="Book" onAction="#book" />
         </children>
      </HBox>
      <!-- All booked appointments; select one and press Cancel to remove it -->
      <ListView fx:id="appointmentList" prefHeight="220.0" />
      <Button text="Cancel Selected Appointment" onAction="#cancel" />
      <!-- Success / error messages -->
      <Label fx:id="statusLabel" />
      <!-- Back to the main menu: AppointmentsController.back() -->
      <Button text="Back" onAction="#back" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
