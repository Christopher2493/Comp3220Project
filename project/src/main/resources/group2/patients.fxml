<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted (Claude): temporary patients test screen (list, add); Ayushmaan's GUI will replace it. Reviewed by Vince. -->
<!--
  Patients screen. Controller: PatientsController.
  fx:id="x" links an element to the @FXML field named x in the controller;
  onAction="#name" calls the @FXML method with that name.
-->

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="group2.PatientsController">
   <children>
      <Label text="Patients" />
      <!-- All registered patients -->
      <ListView fx:id="patientList" prefHeight="240.0" />
      <!-- Add-patient form: handled by PatientsController.addPatient() -->
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="idField" promptText="Patient ID" prefWidth="100.0" />
            <TextField fx:id="nameField" promptText="Patient name" prefWidth="200.0" />
            <Button text="Add Patient" onAction="#addPatient" />
         </children>
      </HBox>
      <!-- Success / error messages -->
      <Label fx:id="statusLabel" />
      <!-- Back to the main menu: PatientsController.back() -->
      <Button text="Back" onAction="#back" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
