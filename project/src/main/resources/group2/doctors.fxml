<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted (Claude): temporary doctors test screen (list, schedule, add); Ayushmaan's GUI will replace it. Reviewed by Vince. -->
<!--
  Doctors screen. Controller: DoctorsController.
  fx:id="x" links an element to the @FXML field named x in the controller;
  onAction="#name" calls the @FXML method with that name.
-->

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="group2.DoctorsController">
   <children>
      <Label text="Doctors" />
      <!-- Left: all doctors. Right: schedule of the doctor selected on the left -->
      <HBox spacing="10.0">
         <children>
            <ListView fx:id="doctorList" prefHeight="220.0" prefWidth="280.0" />
            <TextArea fx:id="scheduleArea" editable="false" prefHeight="220.0" prefWidth="280.0" promptText="Select a doctor to see their schedule" />
         </children>
      </HBox>
      <!-- Add-doctor form: handled by DoctorsController.addDoctor() -->
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="idField" promptText="Doctor ID" prefWidth="100.0" />
            <TextField fx:id="nameField" promptText="Doctor name" prefWidth="200.0" />
            <Button text="Add Doctor" onAction="#addDoctor" />
         </children>
      </HBox>
      <!-- Success / error messages -->
      <Label fx:id="statusLabel" />
      <!-- Back to the main menu: DoctorsController.back() -->
      <Button text="Back" onAction="#back" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
